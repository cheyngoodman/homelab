# OpenTofu. Unanchored patterns cover both the root module and tests/render.
# .terraform.lock.hcl is intentionally NOT ignored; OpenTofu wants it
# committed so provider version selections stay reproducible.
.terraform/
terraform.tfstate
terraform.tfstate.*
.terraform.tfstate.lock.info
terraform.tfvars
*.tfplan

# Scratch plan/apply logs (ad-hoc *.txt captures, never meant to be tracked)
*_output.txt
plan_recheck*.txt

# OS noise
.DS_Store
Thumbs.db

# Local agent state; session settings and worktrees, never repo content
.claude/

# Secrets
*.pem
*.key
.env

# Kubernetes Secrets. This repo ships NO Secret manifests, not even templates.
# Every Secret is generated by cloud-init.tf out of terraform.tfvars and
# delivered by cloud-init (FLUX.md Bootstrap), so there is no file to fill in
# and no file to accidentally commit. These patterns are a backstop in case
# someone adds one anyway.
clusters/**/*secret*.yaml
clusters/**/*token*.yaml
infra/**/*secret*.yaml
infra/**/*token*.yaml
apps/**/*secret*.yaml
apps/**/*token*.yaml
# The rebuild report: a run log, not repo content.
REBUILD-REPORT.md
